{
  "name": "warden-security",
  "displayName": "Warden Security Scanner",
  "description": "AI-powered security review tool for web applications - Real-time vulnerability scanning and security insights",
  "version": "0.8.0",
  "publisher": "warden-security",
  "author": "Yanis",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pamacea/warden"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "icon": "icon.png",
  "categories": [
    "Linters",
    "Testing",
    "Security"
  ],
  "keywords": [
    "security",
    "scanner",
    "owasp",
    "vulnerability",
    "pentest",
    "web-security",
    "ast",
    "static-analysis",
    "rust"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onLanguage:javascript",
    "onLanguage:javascriptreact",
    "onLanguage:typescript",
    "onLanguage:typescriptreact",
    "onLanguage:python",
    "onLanguage:rust",
    "onCommand:warden.scanCurrentFile",
    "onCommand:warden.scanProject",
    "onCommand:warden.showFindings",
    "onCommand:warden.scanUrl"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "warden.scanCurrentFile",
        "title": "Warden: Scan Current File",
        "icon": "$(shield)",
        "category": "Warden"
      },
      {
        "command": "warden.scanProject",
        "title": "Warden: Scan Project",
        "icon": "$(search)",
        "category": "Warden"
      },
      {
        "command": "warden.showFindings",
        "title": "Warden: Show Findings Panel",
        "icon": "$(list-tree)",
        "category": "Warden"
      },
      {
        "command": "warden.scanUrl",
        "title": "Warden: Scan URL",
        "icon": "$(globe)",
        "category": "Warden"
      },
      {
        "command": "warden.refreshFindings",
        "title": "Refresh",
        "icon": "$(refresh)",
        "category": "Warden"
      },
      {
        "command": "warden.clearFindings",
        "title": "Clear All Findings",
        "icon": "$(clear-all)",
        "category": "Warden"
      },
      {
        "command": "warden.configureWarden",
        "title": "Warden: Configure Settings",
        "icon": "$(settings-gear)",
        "category": "Warden"
      },
      {
        "command": "warden.ignoreFinding",
        "title": "Ignore Finding",
        "category": "Warden"
      },
      {
        "command": "warden.copyFindingId",
        "title": "Copy Finding ID",
        "category": "Warden"
      },
      {
        "command": "warden.applyQuickFix",
        "title": "Apply Quick Fix",
        "category": "Warden"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "warden-container",
          "title": "Warden Security",
          "icon": "shield.svg"
        }
      ]
    },
    "views": {
      "warden-container": [
        {
          "id": "warden.findings",
          "name": "Security Findings",
          "icon": "$(shield)",
          "contextualTitle": "Warden Security Findings"
        },
        {
          "id": "warden.dashboard",
          "name": "Security Dashboard",
          "icon": "$(dashboard)",
          "type": "webview",
          "contextualTitle": "Warden Security Dashboard"
        }
      ]
    },
    "menus": {
      "commandPalette": [
        {
          "command": "warden.refreshFindings",
          "when": "false"
        },
        {
          "command": "warden.clearFindings",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "warden.refreshFindings",
          "when": "view == warden.findings",
          "group": "navigation"
        },
        {
          "command": "warden.clearFindings",
          "when": "view == warden.findings",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "warden.ignoreFinding",
          "when": "view == warden.findings",
          "group": "inline"
        },
        {
          "command": "warden.copyFindingId",
          "when": "view == warden.findings",
          "group": "inline"
        },
        {
          "command": "warden.applyQuickFix",
          "when": "view == warden.findings && viewItem =~ /hasQuickFix/",
          "group": "inline"
        }
      ],
      "editor/title": [
        {
          "command": "warden.scanCurrentFile",
          "when": "resourceLangId in javascript,javascriptreact,typescript,typescriptreact,python,rust",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "warden.scanCurrentFile",
          "when": "resourceLangId in javascript,javascriptreact,typescript,typescriptreact,python,rust",
          "group": "warden"
        },
        {
          "submenu": "warden.scanSubmenu",
          "when": "resourceLangId in javascript,javascriptreact,typescript,typescriptreact,python,rust",
          "group": "warden"
        }
      ],
      "submenus": [
        {
          "id": "warden.scanSubmenu",
          "label": "Warden Security"
        }
      ],
      "explorer/context": [
        {
          "command": "warden.scanCurrentFile",
          "when": "resourceLangId in javascript,javascriptreact,typescript,typescriptreact,python,rust",
          "group": "warden"
        },
        {
          "command": "warden.scanProject",
          "when": "explorerResourceIsFolder",
          "group": "warden"
        }
      ]
    },
    "configuration": {
      "title": "Warden Security",
      "properties": {
        "warden.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable Warden security scanning"
        },
        "warden.executablePath": {
          "type": "string",
          "default": "warden",
          "description": "Path to the Warden CLI executable"
        },
        "warden.scanOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan files on save"
        },
        "warden.scanOnOpen": {
          "type": "boolean",
          "default": false,
          "description": "Automatically scan files on open"
        },
        "warden.showInlineWarnings": {
          "type": "boolean",
          "default": true,
          "description": "Show vulnerability warnings inline in the editor"
        },
        "warden.severityLevel": {
          "type": "string",
          "enum": ["Info", "Low", "Medium", "High", "Critical"],
          "default": "Low",
          "description": "Minimum severity level to report"
        },
        "warden.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Scan timeout in milliseconds"
        },
        "warden.maxConcurrentScans": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "maximum": 10,
          "description": "Maximum number of concurrent scans"
        },
        "warden.scanMode": {
          "type": "string",
          "enum": ["Passive", "Active", "Stealth", "Aggressive"],
          "default": "Active",
          "description": "Scanning mode (Passive, Active, Stealth, Aggressive)"
        },
        "warden.enableSecretsDetection": {
          "type": "boolean",
          "default": true,
          "description": "Enable secrets leak detection"
        },
        "warden.enableDependencyCheck": {
          "type": "boolean",
          "default": true,
          "description": "Enable dependency vulnerability checking"
        },
        "warden.ignorePatterns": {
          "type": "array",
          "default": [
            "node_modules/**",
            "target/**",
            "dist/**",
            "build/**",
            ".git/**",
            "*.min.js",
            "*.min.css"
          ],
          "description": "Glob patterns to ignore during scanning"
        },
        "warden.notifications": {
          "type": "object",
          "default": {
            "onCritical": true,
            "onHigh": true,
            "onMedium": false,
            "onLow": false,
            "onInfo": false
          },
          "description": "Notification settings for each severity level"
        },
        "warden.panel.position": {
          "type": "string",
          "enum": ["bottom", "right"],
          "default": "right",
          "description": "Position of the Warden findings panel"
        },
        "warden.autoRefresh": {
          "type": "boolean",
          "default": true,
          "description": "Automatically refresh findings when files change"
        }
      }
    },
    "codeActions": [
      {
        "languages": [
          "javascript",
          "javascriptreact",
          "typescript",
          "typescriptreact",
          "python",
          "rust"
        ],
        "actions": [
          {
            "kind": "warden.quickfix",
            "title": "Warden: Apply Security Fix",
            "description": "Apply the recommended security fix"
          }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.11"
  }
}
